{
    "version": "2021.12",
    "core-network-configuration": {
        "VpnEcmpSupport": false,
        "asn-ranges": [
            "64512-65534"
        ],
      "EdgeLocations": [
        {
          "Location": "us-east-1"
          
        },
        {
          "Location": "us-west-2"
        }
      ]
    },
    "Segments": [
      {
        "Name": "Shared-Services",
        "Description": "Central shared segment for common services",
        "RequireAttachmentAcceptance": false,
        "isolate-attachments": false,
        "Tags": {
          "Category": "Network",
          "Environment": "Shared"
        }
      },
      {
        "Name": "Production",
        "Description": "Production workload segment",
        "RequireAttachmentAcceptance": false,
        "isolate-attachments": true,
        "Tags": {
          "Environment": "Production"
        }
      },
      {
        "Name": "Development",
        "Description": "Development and testing segment",
        "RequireAttachmentAcceptance": false,
        "isolate-attachments": true,
        "Tags": {
          "Environment": "Development"
        }
      }
    ],
    "SegmentActions": [
      {
        "Action": "share",
        "Mode": "attachment-route",
        "Segment": "Shared-Services",
        "ShareWith": ["*"],
        "Description": "Share the shared services segment with all attachments"
      }
      ]
    }